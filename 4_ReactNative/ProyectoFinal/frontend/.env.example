# defino la url del backend para cada entorno sin hardcodearla
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
# IDs públicos de las apps OAuth. Nunca guardes secretos del proveedor en el frontend.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=cliente-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=cliente-android.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=cliente-ios.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
# Si el proveedor requiere callback fijo, pegá aquí la URL registrada en sus ajustes.
EXPO_PUBLIC_SOCIAL_REDIRECT_URI=
