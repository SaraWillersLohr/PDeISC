{
  "expo": {
    "name": "EstanciaApp",
    "slug": "estanciaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estanciaapp",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123824"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123824",
        "foregroundImage": "./assets/branding/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EstanciaApp necesita acceder a tus fotos para elegir una imagen de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#123824"
        }
      ]
    ]
  }
}
