# configuración de mariadb (puerto 3307 según consigna)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=estancia_app

# servidor express
PORT=3001
NODE_ENV=development

# jwt para protección de rutas (fase 2)
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# OAuth social. No subas los valores reales al repositorio.
# La URL de API debe coincidir con las Redirect URI configuradas en cada proveedor.
SESSION_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
SOCIAL_AUTH_API_URL=http://localhost:3001
SOCIAL_AUTH_FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
