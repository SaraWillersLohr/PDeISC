# En dispositivo físico, reemplazá localhost por la IP LAN de la computadora.
# Android Emulator suele acceder al host con 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
# Expo Web corre en la misma PC que la API; no uses aquí la IP del teléfono.
EXPO_PUBLIC_API_URL_WEB=http://localhost:3001/api
