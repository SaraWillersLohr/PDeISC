# defino la configuración local o de aiven sin exponer secretos
PORT=3010
FRONTEND_ORIGIN=http://localhost:8081
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_base_de_datos
DB_PASSWORD=contraseña_de_base_de_datos
DB_NAME=estancia_app
DB_SSL=false
# En Aiven con DB_SSL=true, pegar el certificado CA del proyecto en DB_CA_CERT.
DB_CA_CERT=
JWT_ACCESS_SECRET=reemplazar_por_un_secreto_largo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_largo
JWT_REFRESH_EXPIRES_IN=7d
# Gmail API envía por HTTPS. Autorizar la cuenta con el permiso gmail.send.
EMAIL_PROVIDER=gmail_api
GMAIL_CLIENT_ID=cliente-oauth-web.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=secreto-del-cliente-oauth
GMAIL_REFRESH_TOKEN=refresh-token-de-la-cuenta-remitente
MAIL_FROM=EstanciaApp <tu-cuenta@gmail.com>
# Alternativa para instalaciones que ya usan SMTP: EMAIL_PROVIDER=smtp y configurar SMTP_HOST, SMTP_PORT, SMTP_USER y SMTP_PASS.
VERIFICATION_CODE_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_caracteres_o_mas
# Opcionales: el login social acepta solo usuarios activos con correo verificado.
# Google móvil usa cliente web y el callback HTTPS del backend; registrarlo en Google Cloud Console.
GOOGLE_CLIENT_IDS=cliente-web.apps.googleusercontent.com
# Secreto del cliente web de Google.
GOOGLE_CLIENT_SECRET=
# El callback de cada proveedor debe coincidir con /api/auth/<proveedor>/callback en este dominio.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
