{
  "expo": {
    "name": "EstanciaApp",
    "slug": "estancia-app-mobile",
    "version": "1.0.0",
    "icon": "./assets/leaf-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/leaf-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f5ef"
    },
    "plugins": ["expo-secure-store"],
    "android": {
      "package": "app.estancia.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/leaf-icon.png",
        "backgroundColor": "#f4f5ef"
      }
    },
    "ios": {
      "bundleIdentifier": "app.estancia.mobile"
    }
  }
}
