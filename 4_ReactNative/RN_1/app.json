{
  "expo": {
    "name": "EstanciaApp",
    "slug": "estancia-app-mobile",
    "scheme": "estanciaapp",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f4f5ef"
    },
