# defino la configuración local o de aiven sin exponer secretos
PORT=3001
FRONTEND_ORIGIN=http://localhost:8081
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_base_de_datos
DB_PASSWORD=contraseña_de_base_de_datos
DB_NAME=estancia_app
DB_SSL=false
JWT_ACCESS_SECRET=reemplazar_por_un_secreto_largo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_largo
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=usuario_smtp
SMTP_PASS=contraseña_smtp
MAIL_FROM=EstanciaApp <no-reply@example.com>
VERIFICATION_CODE_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_caracteres_o_mas
