{
  "expo": {
    "name": "EstanciaApp",
    "slug": "estanciaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "estanciaapp",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sarawillers.estanciaapp",
      "adaptiveIcon": {
        "backgroundColor": "#123824",
        "foregroundImage": "./assets/branding/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "splash": {
      "image": "./assets/branding/dark/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#123824"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "splash": {
        "image": "./assets/branding/dark/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#123824"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EstanciaApp necesita acceder a tus fotos para elegir una imagen de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EstanciaApp necesita tu ubicación para registrar dónde se notificó la muerte de un animal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/dark/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#123824"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "socialAuth": {},
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "37aed64e-f252-4547-93b7-477d0b6d9284"
      }
    },
    "owner": "sarawillers2306"
  }
}
